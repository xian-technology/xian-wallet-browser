{
  "name": "xian-wallet-browser",
  "version": "0.3.8-beta.3",
  "private": true,
  "description": "Browser wallet workspace for Xian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xian-technology/xian-wallet-browser.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@xian-tech/client": "file:../xian-js/packages/client",
    "@xian-tech/provider": "file:../xian-js/packages/provider"
  },
  "overrides": {
    "@xian-tech/client": "file:../xian-js/packages/client",
    "@xian-tech/provider": "file:../xian-js/packages/provider"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:release": "node --test scripts/release-context.node-test.mjs",
    "validate": "npm run typecheck && npm run build && npm run test && npm run test:release"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
